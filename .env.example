APP_ENV=development
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Bangkok

LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

OCR_MAX_PRODUCED_UNIT_KWH=10000

IMAGE_DIR=tmp/images
REPORT_DIR=reports
REPORT_IMAGE_STORAGE=local #local or r2

CONFIRMATION_EXPIRY_SECONDS=3600

EXPECTED_METER_COUNT=8
DEFAULT_RATE=4.2
VALID_METER_IDS=M1,M2,M3,M4,M5,M6,M7,M8
ADMIN_LINE_USER_IDS=
OWNER_LINE_USER_IDS=
ALLOWED_LINE_SOURCE_IDS=

# ==========================================
# Cloudflare R2 Object Storage (Media Assets)
# ==========================================
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket
R2_PUBLIC_URL=https://your-r2-public-url
